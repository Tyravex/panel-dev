datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  //output   = "../src/generated/prisma"
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  email     String   @unique
  password  String
  role      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
